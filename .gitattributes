# Normalize line endings for text files that Godot / Git diff
* text=auto eol=lf

*.gd text eol=lf diff
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.import binary
